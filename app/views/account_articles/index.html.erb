<% content_for :title, "Manage content" %>

<h2>Manage content</h2>

<% if @articles.empty? %>
  <p>No articles found.</p>
<% else %>
  <ol class="account-article-list">
    <% @articles.each do |article| %>
      <li data-article-id="<%= article.id %>">
        <strong><%= article.title.presence || "Untitled article" %></strong>
        <span><%= pluralize(article.pages_count, "page") %></span>
        <time datetime="<%= article.updated_at.iso8601 %>">Updated <%= article.updated_at.to_date.to_fs(:long) %></time>
        <%= button_to "Edit metadata", edit_account_article_path(article) %>
        <%= button_to "Edit pages", account_article_pages_path(article) %>
      </li>
    <% end %>
  </ol>
<% end %>

<% if @next_cursor %>
  <%= button_to "Next page", account_articles_path, params: { before_id: @next_cursor } %>
<% end %>
