<!DOCTYPE html>
<html>
  <head>
    <title><%= full_title yield(:title) %></title>
    <link rel="manifest" href="/manifest.json">
		<%= action_cable_meta_tag %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield(:itemprop) %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'uppy' %>
    <%= javascript_pack_tag 'svelte_parts' %>
  </head>

  <body data-tag-editor="<%= user_signed_in? && current_user.tag_editor? %>">
    <div id="modal-windows"></div>
    <div id="display-content"></div>
    <div id="display-image"></div>
    <div id="flash-messages"></div>
    <%= render 'layouts/header' %>
    <div id="main">
      <div id="main-container">
        <%= yield %>
        <ul class="background-bubbles">
          <li></li>
          <li></li>
          <li></li>
          <li></li>
          <li></li>
          <li></li>
          <li></li>
          <li></li>
          <li></li>
          <li></li>
        </ul>
      </div>
    </div>
    <div class="text-options">
      <div id="modal-window"></div>
      <div class="bold-option" title="Bold"><span class="editor-icon editor-icon-bold" aria-hidden="true">B</span></div>
      <div class="italic-option" title="Italic"><span class="editor-icon editor-icon-italic" aria-hidden="true">I</span></div>
      <div class="link-option" title="Link"><span class="editor-icon" aria-hidden="true">↗</span></div>
      <div class="heading-option" title="Heading"><span class="editor-icon editor-icon-heading" aria-hidden="true">H</span></div>
      <div class="strikethrough-option" title="Strikethrough"><span class="editor-icon editor-icon-strikethrough" aria-hidden="true">S</span></div>
      <div class="ol-option" title="Numbered list"><span class="editor-icon editor-icon-list" aria-hidden="true">1.</span></div>
      <div class="ul-option" title="Bulleted list"><span class="editor-icon editor-icon-list" aria-hidden="true">•</span></div>
      <div class="blockquote-option" title="Block quote"><span class="editor-icon" aria-hidden="true">»</span></div>
    </div>
    <div class="link-addition-form"><%= text_field_tag :link_input_field, "", placeholder: "http://" %><%= button_tag "Done", class: "link-input-done-button" %></div>
    <div class="link-options">
      <%= button_tag "Edit", class: "link-input-edit-button" %>
      <%= button_tag "Remove", class: "link-input-remove-button" %>
      <%= button_tag "Open", class: "link-input-open-button" %>
    </div>
    <div class="line-options">
      <div><%= file_field_tag :inline_picture, accept: 'image/jpeg,image/gif,image/png', multiple: true, class: "inline-picture-field", data: { prefix: Shrine.storages[:cache].prefix } %><%= label_tag :inline_picture, '▧', class: 'editor-icon', title: 'Insert image' %></div>
    </div>

    <%= debug(params) if Rails.env.development? %>
  </body>
</html>
