<!DOCTYPE html>
<html>
  <head>
    <title><%= full_title yield(:title) %></title>
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", media: "all" %>
  </head>
  <body>
    <header class="fancomics-header">
      <div class="header-container">
        <h1 class="heading"><%= link_to "WindyFall", root_path, id: "logo" %></h1>
        <nav>
          <% if user_signed_in? %>
            <%= link_to "Account", account_path %>
            <%= button_to "Manage content", account_articles_path %>
            <%= button_to "Log out", logout_path, method: :delete %>
          <% else %>
            <%= link_to "Log in", login_path %>
          <% end %>
          <%= link_to "Discord", discord_path %>
        </nav>
      </div>
    </header>
    <main id="main"><div id="main-container"><%= yield %></div></main>
    <%= yield :javascript %>
  </body>
</html>
