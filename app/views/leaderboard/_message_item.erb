<div class="message-item">
  <div class="message-user-display"><b><%= image_tag external_http_url(message.avatar_url), class: 'message-avatar', loading: 'lazy', decoding: 'async' if external_http_url(message.avatar_url) %><%= message.user_name %></b></div>
  <div class="message-content">
    <%= insert_references message.content %>
  </div>
  <div class="message-embeds">
    <% if message.embeds.any? %>
      <% message.embeds.each do |embed| %>
        <div class="embed-description"><%= embed.description %></div>
        <% if external_http_url(embed.image_url) %>
          <%= image_tag external_http_url(embed.image_url), class: 'message-image', loading: 'lazy', decoding: 'async' %>
        <% elsif external_http_url(embed.image_proxy_url) %>
          <%= image_tag external_http_url(embed.image_proxy_url), class: 'message-image', loading: 'lazy', decoding: 'async' %>
        <% elsif external_host?(embed.url, 'www.facebook.com') %>
          <%= deferred_video_embed "https://www.facebook.com/plugins/video.php?href=#{ERB::Util.url_encode(external_http_url(embed.url))}&show_text=false", title: "Facebook video", external_url: embed.url %>
        <% elsif external_http_url(embed.video_url) %>
          <% if external_host?(embed.video_url, 'www.youtube.com') %>
            <%= deferred_video_embed embed.video_url, title: "YouTube video" %>
          <% else %>
            <video class="message-video" controls loop preload="none"><source src="<%= external_http_url(embed.video_url) %>" /></video>
          <% end %>
        <% elsif external_http_url(embed.url) %>
          <%= link_to 'View linked content', external_http_url(embed.url), target: '_blank', rel: 'nofollow ugc noopener noreferrer' %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <% if message.attachments.any? %>
    <% message.attachments.each do |attachment| %>
      <% if external_http_url(attachment.url) %>
        <%= image_tag external_http_url(attachment.url), class: 'message-image', loading: 'lazy', decoding: 'async' %>
      <% end %>
    <% end %>
  <% end %>
  <div class="message-reactions">
    <% message.reactions.each do |reaction| %>
      <% if external_http_url(reaction.emoji_url) %>
        <%= image_tag external_http_url(reaction.emoji_url), class: 'reaction-emoji-image', loading: 'lazy', decoding: 'async' %>
      <% else %>
        <%= reaction.emoji_name %>
      <% end %>
      <%= reaction.count %>
    <% end %>
  </div>
</div>
